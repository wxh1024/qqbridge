{
	"schemaVersion": 1,
	"id": "qqbridge",
	"version": "${version}",
	"name": "QQ聊天桥",
	"description": "客户端桥接：游戏内聊天与视野进入提醒同步到 QQ 官方机器人群聊；群内 @官方机器人 的消息转发为游戏内聊天消息；群内 /l <文字> 可让角色扫描周围告示牌并用男中音（Baritone）寻路过去按活板门/按钮。",
	"authors": [
		"wxh1024"
	],
	"license": "AGPL-3.0",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.qqbridge.QqBridgeClient"
		]
	},
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"baritone": "*"
	}
}
